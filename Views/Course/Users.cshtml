@model IEnumerable<CourseEnrollmentApp.Models.UserViewModel>

@{
    ViewData["Title"] = "User Directory";
}

<div class="container mt-4">
    <h2>User Directory (Fetched Asynchronously)</h2>
    <p>Data retrieved asynchronously from <code>https://jsonplaceholder.typicode.com/users</code></p>

    <table class="table table-striped table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Company Name</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.Name</td>
                    <td>@user.Email</td>
                    <td>@user.Company.Name</td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to Courses</a>
</div>