@model CourseEnrollmentApp.Models.Course
@using CourseEnrollmentApp.Extensions

@{
    ViewData["Title"] = "Course Details";
}

<div class="container mt-4">
    <h2>Course Details</h2>
    <p class="text-muted"><small>Cached Page Timestamp: @DateTime.Now.ToString("HH:mm:ss") (Response Caching Enabled)</small></p>

    <div class="card my-3" style="max-width: 500px;">
        <div class="card-body">
            <h4 class="card-title">@Model.CourseName</h4>
            <p><strong>Duration:</strong> @Model.Duration</p>
            <p><strong>Base Price:</strong> $@Model.Fees</p>
            <p><strong>Discount:</strong> @Model.DiscountPercentage%</p>
            <h5 class="text-success"><strong>Final Price: $@Model.CalculateFinalFees()</strong></h5>
        </div>
    </div>

    <!-- Enrollment Form utilizing Hidden Field -->
    <form asp-controller="Home" asp-action="Enroll" method="post" class="mt-3">
        <!-- Hidden Field: Stores CourseId -->
        <input type="hidden" name="hiddenCourseId" value="@Model.CourseId" />
        
        <div class="mb-3" style="max-width: 500px;">
            <label class="form-label">Student Name:</label>
            <input type="text" name="studentName" value="@ViewBag.StudentName" class="form-control" required />
        </div>

        <button type="submit" class="btn btn-success">Confirm Enrollment</button>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </form>
</div>